# medme-ehr · 双编排共用环境样例
# 用法：cp deploy/.env.sample deploy/.env 后按需改；.env 已被 .gitignore 排除（勿提交真值）。
#
# ⚠️ D4「参数传进去≠生效」：改完必看容器 stderr 的 [证据] 行（ADDR/EHR_HOME 与实际 bind 同源）。

# 镜像 tag（仅 docker-compose.ghcr.yml 用；local 编排忽略）
EHR_IMAGE_TAG=latest

# 宿主暴露端口（默认只绑本机回环；阶段5 鉴权完成后才考虑改 0.0.0.0）
EHR_BIND_ADDR=127.0.0.1
EHR_BIND_PORT=8585

# 容器内监听地址与数据目录
EHR_CONTAINER_ADDR=0.0.0.0:8443
EHR_HOME=/home/ehr

# API base（SKILL / 客户端脚本用；host 部分与上面绑定一致）
EHR_API_BASE=http://127.0.0.1:8585

# 阶段5 鉴权后启用（当前版本服务端尚未实现 token 中间件，填了也不生效）
EHR_API_TOKEN=

# 构建期镜像源（local 编排用；CI 用 workflow 内置默认值）
CARGO_SPARSE_URL=https://mirrors.tuna.tsinghua.edu.cn/crates.io-index/
CARGO_STATIC_ROOT=https://static.crates.io
APT_MIRROR=https://mirrors.tuna.tsinghua.edu.cn/debian
# 宿主代理（mihomo mixed-port 7890）；置空=直连
HTTPS_PROXY=http://host.docker.internal:7890
HTTP_PROXY=http://host.docker.internal:7890
